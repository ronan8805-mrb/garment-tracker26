{
  "name": "laundrytrack-desktop",
  "version": "1.0.0",
  "description": "LaundryTrack - Mr Bubbles Express Garment Tracking System",
  "main": "main.js",
  "author": "Mr Bubbles Express",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.mrbubblesexpress.laundrytrack",
    "productName": "LaundryTrack",
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "icon.png",
      "signAndEditExecutable": false
    },
    "files": [
      "main.js",
      "preload.js"
    ]
  }
}
